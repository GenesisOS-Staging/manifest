<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="GenesisOS"
           fetch="https://github.com/GenesisOS"
           revision="verve" />

  <remote  name="GenesisOS-Staging"
           fetch="https://github.com/GenesisOS-Staging"
           revision="verve-qpr1" />

  <remote  name="GitLab"
           fetch="https://gitlab.com"
           revision="fifteen" />

  <remote  name="GenesisOS-GitLab"
           fetch="https://gitlab.com/GenesisOS-Fifteen"
           revision="verve" />

  <!-- art -->
  <project path="art" name="art" groups="pdk" remote="GenesisOS-Staging" />

  <!-- bionic -->
  <project path="bionic" name="bionic" groups="pdk" remote="GenesisOS-Staging" />

  <!-- bootable -->
  <project path="bootable/deprecated-ota" name="bootable_deprecated-ota" groups="pdk-cw" remote="GenesisOS-Staging" />
  <project path="bootable/recovery" name="bootable_recovery" groups="pdk" remote="GenesisOS-Staging" />

  <!-- build -->
  <project path="build/make" name="build_make" groups="pdk,sysui-studio" remote="GenesisOS-Staging" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="build/release" name="build_release" groups="pdk,tradefed" remote="GenesisOS-Staging" />
  <project path="build/soong" name="build_soong" groups="pdk,tradefed" remote="GenesisOS-Staging" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- external -->
  <project path="external/skia" name="external_skia" groups="pdk,qcom_msm8x26" remote="GenesisOS-Staging" />

  <!-- frameworks -->
  <project path="frameworks/av" name="frameworks_av" groups="pdk" remote="GenesisOS-Staging" />
  <project path="frameworks/base" name="android_frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="GenesisOS-Staging" />
  <project path="frameworks/native" name="frameworks_native" groups="pdk" remote="GenesisOS-Staging" />

  <!-- hardware -->
  <project path="hardware/google/pixel-sepolicy" name="hardware_google_pixel-sepolicy" groups="generic_fs,pixel" remote="GenesisOS-Staging" />

  <!-- manifest -->
  <project path="manifest" name="manifest" remote="GenesisOS-Staging" />

  <!-- packages -->
  <project path="packages/apps/FaceUnlock" name="packages_apps_FaceUnlock" remote="GenesisOS-GitLab" />
  <project path="packages/apps/Settings" name="packages_apps_Settings" groups="pdk-fs,pdk-cw-tvc" remote="GenesisOS-Staging" />
  <project path="packages/apps/Updater" name="packages_apps_Updater" remote="GenesisOS" />
  <project path="packages/modules/Connectivity" name="packages_modules_Connectivity" groups="pdk-cw-fs,pdk-fs" remote="GenesisOS-Staging" />
  <project path="packages/services/Telecomm" name="packages_services_Telecomm" groups="pdk-cw-fs,pdk-fs" remote="GenesisOS-Staging" />

  <!-- sepolicy -->
  <project path="device/lineage/sepolicy" name="device_lineage_sepolicy" remote="GenesisOS-Staging" />
  <project path="device/mediatek/sepolicy_vndr" name="device_mediatek_sepolicy_vndr" remote="GenesisOS" />

  <!-- system -->
  <project path="system/core" name="system_core" groups="pdk" remote="GenesisOS-Staging" />
  <project path="system/sepolicy" name="system_sepolicy" groups="pdk" remote="GenesisOS-Staging" />
  <project path="system/update_engine" name="system_update_engine" groups="pdk" remote="GenesisOS-Staging" />

  <!-- vendor -->
  <project path="vendor/certification" name="vendor_certification" remote="GenesisOS-Staging" />
  <project path="vendor/genesis" name="vendor_genesis" remote="GenesisOS-Staging" />
  <project path="vendor/google/overlays/ThemeIcons" name="vendor_google_overlays_ThemeIcons" remote="GenesisOS" />
  <project path="vendor/gms" name="pixelos-aosp/vendor_gms" remote="GitLab" />
  <project path="vendor/support" name="vendor_support" remote="GenesisOS" />

</manifest>
